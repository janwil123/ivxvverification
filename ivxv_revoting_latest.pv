(* IVXV re-voting model for one voter — improved.
 *
 * This model isolates the "latest accepted ballot wins" rule for a single
 * voter who successfully casts two ballots.  It now more accurately reflects
 * the source's timestamp-based ordering mechanism.
 *
 * IMPROVEMENTS from previous version:
 *
 * 1. VoteID semantics (voting/main.go:171-178):
 *    VoteIDs are now freshly generated by the Collector (`new`) for each
 *    accepted submission, not pre-agreed private constants.
 *
 * 2. Timestamp-based "latest" ordering (storage/txn.go:264-274):
 *    The source determines "latest" by comparing canonical times (ctime)
 *    extracted from OCSP/TSP qualifying properties, NOT by reception order:
 *
 *      case oldTime.After(ctime):
 *          return nil, nil  // Keep newer (old) vote.
 *      case oldTime.Equal(ctime):
 *          // Corrupt the index.
 *      default:
 *          return votedLatestValue, nil  // Update to new vote.
 *
 *    This model introduces an `ordering` type and a trusted oracle on the
 *    private channel q_oracle.  The oracle provides the ctime comparison
 *    result (v2_later or v1_later), modeling the honest OCSP/TSP service
 *    that the Collector consults.  Both orderings are provided in parallel
 *    so ProVerif explores both cases.
 *
 * 3. Event structure: the FinalStored event now carries the VoteID to link
 *    the final ciphertext to its accepted entry; Cast carries only the
 *    ciphertext (since VoteID is unknown to the voter at cast time).
 *    A LegitCast event records every ciphertext submitted by the honest voter,
 *    used in the "accepted implies cast" query without requiring OR syntax.
 *
 * Remaining limitations:
 *   - Concurrent submission (CAS retry loops in storage/txn.go:122-162)
 *     is not modeled; the Collector processes votes sequentially.
 *   - Timestamp tie-breaking: when ctime values are equal the source corrupts
 *     the latest-index (stores both VoteIDs concatenated); not modeled.
 *   - The q_oracle provides only a binary ordering result; the actual
 *     qualifying timestamp values and their derivation from OCSP producedAt
 *     are abstracted away.
 *)

type skey.
type pkey.
type ballot.
type rand.
type voteid.
type sig.
type ordering.
(* ordering: abstract token representing the ctime comparison result.
 * Replaces the implicit reception-order semantics of the previous model. *)

free net: channel.
free c2obs: channel [private].
free q_oracle: channel [private].
(* q_oracle: trusted qualification comparison channel.  Models the honest
 * OCSP/TSP service whose producedAt timestamps determine ctime ordering
 * (voting/main.go:276-288, storage/txn.go:255-273).  The attacker cannot
 * send on this channel, so the ordering is not attacker-controlled. *)

fun pk(skey): pkey.
fun enc(ballot, rand, pkey): bitstring.
fun sign(bitstring, skey): sig.
fun pack_cipher(bitstring): bitstring.

reduc forall m: bitstring, sk: skey; verify_sig(sign(m, sk), pk(sk)) = m.

free skE: skey [private].
free skV: skey [private].
free b1: ballot [private].
free b2: ballot [private].
free r1: rand [private].
free r2: rand [private].

free v2_later: ordering.
(* v2_later: ctime(vote2) > ctime(vote1); vote2 becomes the latest entry. *)
free v1_later: ordering.
(* v1_later: ctime(vote1) >= ctime(vote2); vote1 remains the latest entry.
 * (Includes both the strictly-after and equal cases from txn.go:265-270;
 *  the equal/tie-breaking corner case is not further distinguished.) *)

event LegitCast(bitstring).
(* LegitCast(c): the honest voter submitted ciphertext c (either ballot). *)
event Cast(ballot, bitstring).
(* Cast(b, c): the honest voter cast ballot b encrypted as ciphertext c. *)
event Accepted(bitstring, voteid).
(* Accepted(c, vid): the Collector accepted c and assigned fresh VoteID vid. *)
event FinalStored(bitstring, voteid).
(* FinalStored(c, vid): c (under vid) is designated as the latest vote for
 * this voter after the second submission.  Corresponds to the
 * votedLatestPrefix entry pointing to vid (storage/txn.go:267-273). *)

(* C1: every accepted ciphertext was submitted by the honest voter. *)
query c: bitstring, vid: voteid;
  event(Accepted(c, vid)) ==> event(LegitCast(c)).

(* C2: the FinalStored ciphertext was accepted under its VoteID. *)
query c: bitstring, vid: voteid;
  event(FinalStored(c, vid)) ==> event(Accepted(c, vid)).

(* C3: the FinalStored ciphertext was cast by the honest voter. *)
query c: bitstring, vid: voteid;
  event(FinalStored(c, vid)) ==> event(LegitCast(c)).

let Voter =
  (* First submission. *)
  let c1 = enc(b1, r1, pk(skE)) in
  let s1 = sign(pack_cipher(c1), skV) in
  event Cast(b1, c1);
  event LegitCast(c1);
  out(net, (c1, s1));
  (* Second submission (re-vote). *)
  let c2 = enc(b2, r2, pk(skE)) in
  let s2 = sign(pack_cipher(c2), skV) in
  event Cast(b2, c2);
  event LegitCast(c2);
  out(net, (c2, s2)).

let Collector =
  (* Receive and verify the first ballot. *)
  in(net, (c_i1: bitstring, s_i1: sig));
  let m1 = verify_sig(s_i1, pk(skV)) in
  if m1 = pack_cipher(c_i1) then
    (* Assign a fresh VoteID (voting/main.go:173). *)
    new vid1_i: voteid;
    event Accepted(c_i1, vid1_i);
    (* Receive and verify the second ballot. *)
    in(net, (c_i2: bitstring, s_i2: sig));
    let m2 = verify_sig(s_i2, pk(skV)) in
    if m2 = pack_cipher(c_i2) then
      new vid2_i: voteid;
      event Accepted(c_i2, vid2_i);
      (* Consult the ordering oracle for the ctime comparison
       * (storage/txn.go:264-274).  The oracle is trusted; only honest
       * OCSP/TSP timestamps feed this decision. *)
      in(q_oracle, ord: ordering);
      if ord = v2_later then
        (* ctime(vote2) > ctime(vote1): update the votedLatestPrefix to vid2.
         * Corresponds to txn.go "default" branch: return votedLatestValue. *)
        event FinalStored(c_i2, vid2_i);
        out(c2obs, c_i2)
      else
        (* ctime(vote1) >= ctime(vote2): keep vote1 as the latest entry.
         * Corresponds to txn.go "oldTime.After(ctime): return nil, nil". *)
        event FinalStored(c_i1, vid1_i);
        out(c2obs, c_i1)
    else 0
  else 0.

let Oracle =
  (* Provide both orderings so ProVerif explores both cases:
   * vote2 has a later ctime (v2_later) OR vote1 has a later/equal ctime
   * (v1_later).  These run in parallel; the Collector non-deterministically
   * receives whichever the ProVerif engine selects first for each trace. *)
  out(q_oracle, v2_later) | out(q_oracle, v1_later).

process
  Oracle | Voter | Collector
