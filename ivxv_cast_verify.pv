(* IVXV cast/verify symbolic model.
 *
 * This model focuses on the protocol slice:
 *   voter encrypts ballot with explicit randomness,
 *   collector stores the resulting ciphertext under a freshly generated VoteID,
 *   voter passes VoteID and encryption witness to their verifier app,
 *   verifier app queries the verification service and checks the stored
 *   ciphertext by recomputing encryption with the disclosed randomness.
 *
 * It intentionally abstracts away BDOC/XAdES, OCSP, timestamping, and the
 * later shuffle/decrypt/tally stages.
 *
 * IMPROVEMENTS from previous version:
 *
 * 1. Removed dead declaration (previous b1: ballot [private] was declared
 *    but never used anywhere in the model).
 *
 * 2. VoteID semantics (voting/main.go:171-178):
 *    VoteID is now collector-generated (`new vid_i`) and returned to the voter
 *    in the RPC response on `net`.  The voter passes it out-of-band to the
 *    verifier app via the private channel v2ver.
 *
 * 3. Verification service has no authentication (verification/main.go:213):
 *    The real verification service states explicitly that no authentication is
 *    used; any caller presenting a valid VoteID receives the stored ballot
 *    container.  The previous model used a private channel c2ver, which hid
 *    the stored vote from the attacker.  This model replaces c2ver with a
 *    dedicated public channel `ver` for the verification service, and uses a
 *    separate VerifyService process to handle the lookup.
 *
 * 4. Multiple voters and voter corruption:
 *    The previous model had one honest voter with global private signing key,
 *    ballot, and randomness.  The model now supports unbounded concurrent
 *    voter sessions:
 *
 *    Voter (replicated):
 *      Each session generates a fresh signing key, ballot, and randomness.
 *      HonestVoterKey(spk) and HonestCast(c) / HonestVoterCast(spk, c) are
 *      fired to mark the session as honest.
 *
 *    CorruptedVoter (replicated):
 *      A voter whose signing key is leaked to the attacker.  The attacker can
 *      then submit arbitrary ciphertexts signed under that key.  Neither
 *      HonestVoterKey nor HonestCast is fired, so ciphertexts stored under
 *      the corrupted key are outside the scoped Stored correspondence.
 *
 * 5. Collector uses signer_pk to extract the signing key from the submitted
 *    signature, replacing the hard-coded global pk(skV) check.  This allows
 *    the Collector to verify signatures from arbitrary voter keys, including
 *    those generated fresh per session.
 *
 * 6. The secrecy query for the ballot plaintext (attacker(pack_ballot(b0)))
 *    is dropped.  With per-session fresh ballots there is no global b0 to
 *    query.  Ballot secrecy before randomness disclosure is argued more
 *    rigorously in ivxv_cast_privacy.pv via observational equivalence.
 *
 * Security note — VoteID delivery:
 *    Because `net` is a public channel, the attacker can intercept or replace
 *    the VoteID returned by the Collector and inject a fake VoteID to the
 *    voter.  This breaks the VerifySuccess ==> Stored correspondence (the
 *    verifier app may check a VoteID that was never stored).  In the real
 *    system this is mitigated by HTTPS server authentication on the submission
 *    endpoint.  The VerifySuccess ==> Stored query is therefore omitted; see
 *    the comment below for the attack trace.
 *
 * Remaining abstractions:
 *   - BDOC/XAdES container structure (pack_cipher is a simplification)
 *   - OCSP/TSP qualification properties not modeled
 *   - Session-authenticated identity cross-check not modeled here (see
 *     ivxv_accept_auth.pv for that claim)
 *   - The verifier app parses the BDOC container to extract the ciphertext;
 *     here VerifySuccess implicitly assumes correct extraction
 *)

type skey.
type pkey.
type ballot.
type rand.
type voteid.
type sig.

free net: channel.
free auth: channel [private].
(* auth: the pre-authenticated session channel.  The voter sends their public
 * signing key as their session identity before submitting the ballot.  The
 * Collector cross-checks this against the key extracted from the BDOC
 * signature (spk = auther), rejecting any mismatch.  Because auth is private
 * the attacker cannot inject a fake session identity for an honest voter.
 * Corresponds to the session-authenticated RPC context in voting/main.go:101. *)
free ver: channel.
(* ver: the public verification service channel.  No authentication is used;
 * any caller may send a VoteID query and receive the stored ciphertext.
 * Corresponds to the verification service endpoint (verification/main.go). *)
free v2ver: channel [private].
(* v2ver: the out-of-band channel from voter to their verifier app.
 * Models the voter communicating VoteID and encryption witness to the
 * verification app (e.g., by showing a QR code). *)
free int_store: channel [private].
(* int_store: internal channel from Collector to VerifyService.
 * Models the shared storage backend (etcd) accessible to both services. *)

fun pk(skey): pkey.
fun enc(ballot, rand, pkey): bitstring.
fun sign(bitstring, skey): sig.
fun pack_ballot(ballot): bitstring.
fun pack_cipher(bitstring): bitstring.

reduc forall m: bitstring, sk: skey; verify_sig(sign(m, sk), pk(sk)) = m.
reduc forall m: bitstring, sk: skey; signer_pk(sign(m, sk)) = pk(sk).
(* signer_pk extracts the public key used to produce a signature, modelling
 * the signing certificate embedded in the BDOC/XAdES container.  Used by
 * the Collector to verify signatures from arbitrary per-session voter keys
 * without relying on a single global pk(skV). *)

free skE: skey [private].
(* skE: the shared election secret key.  One key covers all voters; the
 * election public key pk(skE) is a public parameter. *)

event HonestVoterKey(pkey).
(* HonestVoterKey(spk): spk is the public key of an honest voter session.
 * Fired before any network output.  Used to scope the Stored correspondence
 * to honest sessions, excluding ciphertexts submitted by corrupted voters. *)
event HonestCast(bitstring).
(* HonestCast(c): an honest voter session computed and submitted ciphertext c.
 * Used in the VerifySuccess correspondence where the signer key is not
 * available to the Verifier. *)
event HonestVoterCast(pkey, bitstring).
(* HonestVoterCast(spk, c): honest voter with signing key spk submitted c.
 * Used in the Stored correspondence to tie the stored key to the caster. *)
event Stored(pkey, bitstring, voteid).
(* Stored(spk, c, vid): collector stored ciphertext c, attributed to signer
 * key spk, under VoteID vid. *)
event VerifySuccess(bitstring, voteid).
(* VerifySuccess(c, vid): verifier app confirmed that the ciphertext stored
 * under vid equals enc(b, r, pk(skE)) for the disclosed (b, r). *)

(* OMITTED — not provable with a public verification channel:
 *
 *   query spk: pkey, c: bitstring, vid: voteid;
 *     event(Stored(spk, c, vid)) ==> ... VerifySuccess ...
 *
 * Attack trace:
 *   1. Voter submits (c, s) on net; Collector stores c under vid_i, outputs vid_i on net.
 *   2. Attacker intercepts vid_i and injects vid_fake =/= vid_i on net.
 *   3. Voter receives vid_fake, passes (vid_fake, b, rV) to verifier app.
 *   4. Verifier queries ver with vid_fake; VerifyService has no entry for vid_fake.
 *   5. Attacker injects c (already known from step 1) on ver.
 *   6. Verifier checks c = enc(b, rV, pk(skE)) — holds — fires VerifySuccess(c, vid_fake).
 *   7. Stored(spk, c, vid_fake) was never fired (only Stored(spk, c, vid_i) was).
 *
 * The real system mitigates this via HTTPS server authentication on the
 * submission endpoint (the voter's client authenticates the Collector's TLS
 * certificate before trusting the returned VoteID). *)

(* Stored correspondence scoped to honest voter sessions:
 * if the Collector stored a ciphertext attributed to an honest voter's key,
 * that voter's session actually submitted it.  Ciphertexts stored under
 * corrupted voters' keys are outside this claim. *)
query spk: pkey, c: bitstring, vid: voteid;
  event(Stored(spk, c, vid)) && event(HonestVoterKey(spk)) ==>
  event(HonestVoterCast(spk, c)).

(* VerifySuccess correspondence:
 * if the verifier app accepted a ciphertext, an honest voter cast it.
 * This holds even with corrupted voters and a public ver channel: the
 * verifier checks c_s = enc(b_v, r_v, pk(skE)) using (b_v, r_v) received
 * on the private v2ver channel.  Since only honest Voter processes send on
 * v2ver, the matching ciphertext must have been computed by an honest voter. *)
query c: bitstring, vid: voteid;
  event(VerifySuccess(c, vid)) ==> event(HonestCast(c)).

let Voter =
  (* Each session generates fresh private key, ballot, and randomness.
   * This models the real system where every voter has a distinct key pair
   * from the Estonian PKI and samples fresh ElGamal randomness independently. *)
  new skV: skey;
  new b: ballot;
  new rV: rand;
  event HonestVoterKey(pk(skV));
  (* Establish the authenticated session by presenting the signing public key.
   * In the real protocol this is derived from the TLS/ticket authentication
   * certificate (voting/main.go:101). *)
  out(auth, pk(skV));
  let c = enc(b, rV, pk(skE)) in
  let msg = pack_cipher(c) in
  let s = sign(msg, skV) in
  event HonestCast(c);
  event HonestVoterCast(pk(skV), c);
  out(net, (c, s));
  (* Receive the VoteID generated by the Collector in the RPC response. *)
  in(net, vid_resp: voteid);
  (* Pass VoteID and encryption witness to the verifier app out-of-band. *)
  out(v2ver, (vid_resp, b, rV)).

let CorruptedVoter =
  (* A voter whose signing key is known to the attacker.  The key is leaked
   * on net; the attacker can then sign arbitrary ciphertexts.  A session
   * identity is also placed on auth so the attacker can get those submissions
   * past the Collector's session cross-check.  Since HonestVoterKey is not
   * fired, ciphertexts stored under this key are outside the scoped
   * Stored correspondence. *)
  new skV: skey;
  out(net, skV);
  out(auth, pk(skV)).

let Collector =
  (* Read the pre-authenticated session identity (voting/main.go:101). *)
  in(auth, auther: pkey);
  in(net, (c_i: bitstring, s_i: sig));
  (* Extract the signing public key from the signature (models BDOC/XAdES
   * certificate extraction).  Replaces the former global pk(skV) check,
   * allowing signatures from arbitrary per-session voter keys. *)
  let spk = signer_pk(s_i) in
  (* Cross-check: reject if the session identity does not match the BDOC
   * signer key (voting/main.go:160).  Without this check the Collector would
   * accept a ballot signed by a key unrelated to the authenticated session. *)
  if spk = auther then (
    let m = verify_sig(s_i, spk) in
    if m = pack_cipher(c_i) then
      (* Generate a fresh VoteID (voting/main.go:173: genIdent()). *)
      new vid_i: voteid;
      event Stored(spk, c_i, vid_i);
      (* Return VoteID in the RPC response. *)
      out(net, vid_i);
      (* Make the stored vote available to the VerifyService via the shared backend. *)
      out(int_store, (vid_i, c_i))
    else 0
  ) else 0.

let VerifyService =
  (* Receive the stored (VoteID, ciphertext) pair from the shared backend. *)
  in(int_store, (vid_s: voteid, c_s: bitstring));
  (* Respond to one VoteID query.  No authentication is required; any caller
   * presenting the correct VoteID receives the stored ciphertext
   * (verification/main.go:213 — "No authentication is used"). *)
  in(ver, vid_q: voteid);
  if vid_q = vid_s then out(ver, c_s).

let Verifier =
  (* Receive VoteID and encryption witness from the voter's app. *)
  in(v2ver, (vid_v: voteid, b_v: ballot, r_v: rand));
  (* Query the verification service with the VoteID. *)
  out(ver, vid_v);
  (* Receive the stored ciphertext. *)
  in(ver, c_s: bitstring);
  (* Recompute the expected ciphertext and compare (client-side check). *)
  if c_s = enc(b_v, r_v, pk(skE)) then
    event VerifySuccess(c_s, vid_v).

process
  !Voter | !CorruptedVoter | !Collector | !VerifyService | !Verifier
